{
  "name": "dsh-profile-web",
  "private": true,
  "description": "dsh-KazMode 示例：把 dependencies 合并进 ~/.dsh/profiles/web/package.json（保留你原有依赖与 bundles）",
  "dependencies": {
    "code-collapse": "file:plugins/code-collapse",
    "kaz-memory": "file:plugins/kaz-memory",
    "kaz-mode": "file:plugins/kaz-mode",
    "kaz-no-context": "file:plugins/kaz-no-context",
    "output-beep": "file:plugins/output-beep",
    "round-display": "file:plugins/round-display",
    "round-minimal": "file:plugins/round-minimal",
    "task-master-whiteboard": "file:plugins/task-master-whiteboard",
    "thinking-anchor": "file:plugins/thinking-anchor",
    "tool-filter": "file:plugins/tool-filter",
    "tool-grouping": "file:plugins/tool-grouping"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app"
      ]
    }
  }
}
