{
  "name": "kaz-memory",
  "version": "0.1.0",
  "description": "Kaz 记忆插件：跨会话明文记忆（memory_save/list/search/forget 四工具 + 人工确认闸门 + 每条记忆可标记「自动载入」）——已确认且标记自动载入的记忆会在 memory_search 首次可用时以上下文注入方式自动注入一次（如 round-minimal 第二轮），其余记忆靠模型主动 memory_search 获取；项目记忆按项目文件夹隔离（<项目>/.dsh/storages/memory_project.json），项目根从 agent 会话 cwd 解析；客户端半在会话头部提供「记忆」按钮、待确认面板、自动载入开关与「打开记忆文件夹」按钮（面板经 portal 定位不被侧边栏裁剪）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/engine.js",
    "lib/bm25.js"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-storage-json": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
