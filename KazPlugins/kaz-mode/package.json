{
  "name": "kaz-mode",
  "version": "3.2.2",
  "description": "kaz-mode 超级模式插件：Kaz 模式 agent preset + 会话头部开关按钮 + 集中管理面板，统一联动管理 thinking-anchor / round-minimal / plugin-filter / output-beep / round-display / deepseek-default-model / kaz-memory。系统提示词由 kaz 预设的 kaz-system-prompt.mjs 控制（默认 \"You are a helpful software engineer assistant.\"，kaz-memory 启用时切换为记忆优先提示词），工具面 = 工具控制面板三层 JSON（原设置 → 用户默认 → 项目专属）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ],
  "scripts": {
    "check:version": "node check-version.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "kaz-shared": "file:../kaz-shared"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
