{
  "name": "kaz-mode",
  "version": "6.0.2",
  "description": "kaz-mode 超级模式插件：Kaz 模式 agent preset + 会话头部开关按钮 + 集中管理面板，面板只显示 output-beep / deepseek-default-model / kaz-agent-preset-display / round-display + 外置工具添加通道，内部联动 ka-whale-memory / ka-whale-workflow / plugin-filter。36.9：round-minimal 已删除，首阶段 Minimal 与工具面变化上报由本插件核心直接拥有。v0.8 Step A/B1/B2：Stable Main Surface 固定集，原生 Plan 与 kaz_tool_auto_on 均已退役，create-plan 插件目录已删除。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ],
  "scripts": {
    "check:version": "node check-version.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "kaz-shared": "file:../kaz-shared"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
