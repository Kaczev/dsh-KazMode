{
  "name": "code-collapse",
  "version": "0.1.0",
  "description": "工具塌缩插件：把每个会话的工具面折叠成唯一入口 run_code（Code Mode 呈现，附生成 SDK 提示），并在每次 run_code 调用完成后追加一条 We need 推理风格提醒（双语信封，默认文案可配）。Kaz 模式默认启用、面板可关；也可独立使用。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
