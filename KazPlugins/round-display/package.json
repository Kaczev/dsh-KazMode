{
  "name": "round-display",
  "version": "0.1.0",
  "description": "round-display：Kaz 模式轮次显示插件——记录每一轮开始时 Kaz 模式联动/附属插件（thinking-anchor / round-minimal / code-collapse / kaz-memory 等）给模型发送的信息，客户端在对话输入区右侧提供「本轮注入」按钮与面板（[插件]>内容< 格式）。宿主经 system-prompt/assemble 瀑布被动捕获 + roundDisplay.report 主动上报，按 agent × 轮次存档，经专用 RPC 通道（/round-display，loopback）供面板读取。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
